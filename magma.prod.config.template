
# =============================================================================
# Magma production config TEMPLATE
# -----------------------------------------------------------------------------
# This is NOT a ready config. It is the sandbox config with every environment-
# and secret-specific value replaced by a placeholder. Run gen-secrets.sh to
# render a real config from it (it fills every token, generates the key files,
# and emits the DB + DNS material):
#
#     ./gen-secrets.sh --domain example.com --config-prefix /etc/magma
#
# NEVER bake the rendered config or its key files into a container image.
# Keep them in a secrets store / mounted volume. See HARDENING notes below.
# =============================================================================

# --- Anti-virus -------------------------------------------------------------
magma.iface.virus.signatures = __VIRUS_SIGS__
magma.iface.virus.available = true

# --- Logging (prod: log to file, not just stdout) ---------------------------
magma.output.file = true
magma.output.path = __LOG_PATH__

magma.log.content = false
magma.log.file = true
magma.log.function = true
magma.log.http = false
magma.log.imap = false
magma.log.line = true
magma.log.stack = false
magma.log.time = true

# --- Identity ---------------------------------------------------------------
magma.system.domain = __DOMAIN__
# Loopback relay is allowed to inject without auth. Keep it on the loopback
# address ONLY; never widen this to a routable interface.
magma.smtp.bypass_addr = 127.0.0.1

magma.web.tls_redirect = __TLS_REDIRECT__
magma.web.statistics = true

# --- DIME (dark mail) keypair + org signet ----------------------------------
magma.dime.key = __DIME_KEY__
magma.dime.signet = __DIME_SIGNET__

# --- DKIM: private key here, publish the .txt record in DNS -----------------
magma.dkim.enabled = true
magma.dkim.selector = __DKIM_SELECTOR__
magma.dkim.domain = __DOMAIN__
magma.dkim.key = __DKIM_KEY__

# --- Secrets: MUST be unique per deployment AND distinct from each other ----
magma.secure.memory.length = 65536
magma.secure.salt = __SECURE_SALT__
magma.secure.sessions = __SECURE_SESSIONS__

# --- Web / HTTP -------------------------------------------------------------
magma.http.close = true
magma.web.portal.indent = false
# Prod default: do NOT allow cross-domain unless a separate front-end needs it.
magma.http.allow_cross_domain = false
magma.config.output_config = false

magma.admin.contact = __ADMIN_CONTACT__
magma.admin.abuse = __ADMIN_ABUSE__

# Prod: run in the background (the container start-script flips this if needed).
magma.system.daemonize = true

# --- Cache (memcached) ------------------------------------------------------
magma.iface.cache.host[1].name = __CACHE_HOST__
magma.iface.cache.host[1].port = __CACHE_PORT__

# --- Web assets -------------------------------------------------------------
magma.http.pages = __PAGES__
magma.http.templates = __TEMPLATES__
magma.http.fonts = __FONTS__

# --- Database ---------------------------------------------------------------
magma.iface.database.host = __DB_HOST__
magma.iface.database.password = __DB_PASSWORD__
magma.iface.database.pool.connections = 6
magma.iface.database.schema = __DB_SCHEMA__
magma.iface.database.socket_path = __DB_SOCKET__
magma.iface.database.user = __DB_USER__

# --- Shared object + storage ------------------------------------------------
magma.library.file = __LIBRARY_FILE__
magma.library.unload = false

magma.spool = __SPOOL__
magma.storage.tank = __STORAGE_TANK__
magma.storage.root = __STORAGE_ROOT__
magma.storage.default = local

# --- System / resource hardening --------------------------------------------
magma.system.enable_core_dumps = false
magma.system.increase_resource_limits = true
magma.system.worker_threads = 64
# Prod: enable the portal safeguard.
magma.web.portal.safeguard = true

# --- Outbound relay (local Postfix smarthost, or a real relay) --------------
magma.relay.timeout = 60
magma.relay[1].name = __RELAY_HOST__
magma.relay[1].port = __RELAY_PORT__

# =============================================================================
