diff --git a/src/value.c b/src/value.c
index 07af087..f210cb8 100644
--- a/src/value.c
+++ b/src/value.c
@@ -1110,3 +1110,41 @@ json_t *do_deep_copy(const json_t *json, hashtable_t *parents) {
             return NULL;
     }
 }
+
+/* magma: non-inline definitions of the wrappers un-inlined in jansson.h, so
+   they are exported from libjansson and resolvable via dlsym. Behaviour is
+   identical to the stock inline versions. */
+json_t *json_incref(json_t *json) {
+    if (json && json->refcount != (size_t)-1)
+        JSON_INTERNAL_INCREF(json);
+    return json;
+}
+
+void json_decref(json_t *json) {
+    if (json && json->refcount != (size_t)-1 && JSON_INTERNAL_DECREF(json) == 0)
+        json_delete(json);
+}
+
+int json_object_set(json_t *object, const char *key, json_t *value) {
+    return json_object_set_new(object, key, json_incref(value));
+}
+
+int json_object_set_nocheck(json_t *object, const char *key, json_t *value) {
+    return json_object_set_new_nocheck(object, key, json_incref(value));
+}
+
+int json_object_iter_set(json_t *object, void *iter, json_t *value) {
+    return json_object_iter_set_new(object, iter, json_incref(value));
+}
+
+int json_array_set(json_t *array, size_t ind, json_t *value) {
+    return json_array_set_new(array, ind, json_incref(value));
+}
+
+int json_array_append(json_t *array, json_t *value) {
+    return json_array_append_new(array, json_incref(value));
+}
+
+int json_array_insert(json_t *array, size_t ind, json_t *value) {
+    return json_array_insert_new(array, ind, json_incref(value));
+}
